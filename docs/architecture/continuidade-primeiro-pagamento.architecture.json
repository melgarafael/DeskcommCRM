    {"id":"auth","lane":"servidor","col":2,"type":"security","label":"Auth nativo","sublabel":"Confirmação, sessão, MFA e autoridade financeira"},
    {"id":"hub","lane":"servidor","col":2,"type":"backend","label":"Hub de suspensão","sublabel":"Primeiro pagamento; admin fora de suporte"},
    {"id":"continuar","lane":"pessoa","col":3,"type":"frontend","label":"/cobranca/contratar","sublabel":"Plano do banco; documento faltante; retry"},
    {"id":"checkout","lane":"financeiro","col":3,"type":"backend","label":"POST checkout existente","sublabel":"Intenção revalidada; CAS e idempotência"},
    {"id":"gateway","lane":"financeiro","col":4,"type":"external","label":"Gateway conectado","sublabel":"Pagamento e avisos nativos"},
    {"id":"confirmar","lane":"financeiro","col":4,"type":"backend","label":"Retorno + sincronizar","sublabel":"Só assinatura ativa e org operante"},
    {"id":"onboarding","lane":"pessoa","col":5,"type":"frontend","label":"/onboarding/welcome"},
