    {
      "id": "db",
      "label": "Postgres"
    },
    {
      "id": "external",
      "label": "Canal externo"
    }
  ],
  "mainPath": [
    "inbound",
    "boundary",
    "origin",
    "receipt",
    "job",
    "guard",
    "sink",
    "transport"
