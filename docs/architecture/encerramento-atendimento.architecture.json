  "nodes": [
    {
      "id": "inbox",
      "lane": "ui",
      "col": 1,
      "type": "frontend",
      "label": "Inbox — conversa, demanda e fatos"
    },
    {
      "id": "commands",
      "lane": "service",
      "col": 2,
      "type": "backend",
      "label": "close/reopen CAS e encerramento explícito da demanda"
    },
    {
      "id": "inbound",
      "lane": "db",
      "col": 3,
      "type": "database",
