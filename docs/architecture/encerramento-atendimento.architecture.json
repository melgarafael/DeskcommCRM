{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Fronteira do atendimento — comunidade 360 Task4",
    "subtitle": "Conversa e demanda têm encerramentos independentes; efeitos operacionais conservam sua origem",
    "output": "encerramento-atendimento.html",
    "quality_profile": "standard"
