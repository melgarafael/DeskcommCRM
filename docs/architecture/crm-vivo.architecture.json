    { "id": "e17", "from": "decisao", "to": "fila", "label": "aprovar = autorizar e agendar" },
    { "id": "e18", "from": "decisao", "to": "leadstate", "label": "grava status + identidade da proposta" },
    { "id": "e19", "from": "leadstate", "to": "ritual", "label": "A DECISÃO HUMANA VOLTA AO CONTEXTO", "route": "highlight" },
    { "id": "e20", "from": "fila", "to": "ritual", "label": "followup_turn executa" },
    { "id": "e21", "from": "eventlog", "to": "workerscore", "label": "recalcula com debounce" },
