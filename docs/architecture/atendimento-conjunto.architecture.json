  "meta": { "title": "Atendimento conjunto", "subtitle": "Convite concede leitura e resposta sem transferir o responsável", "output": "atendimento-conjunto.html", "quality_profile": "standard" },
  "lanes": [{ "id": "tela", "label": "Inbox" }, { "id": "servidor", "label": "Autorização" }, { "id": "banco", "label": "Persistência" }],
