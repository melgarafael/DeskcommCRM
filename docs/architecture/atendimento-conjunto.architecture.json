    { "id": "e2", "from": "rota", "to": "participacao", "label": "upsert ou saída lógica" },
    { "id": "e3", "from": "rota", "to": "auditoria", "label": "audita o efeito" },
    { "id": "e4", "from": "participacao", "to": "leitura", "label": "participação ativa amplia leitura" },
    { "id": "e5", "from": "leitura", "to": "resposta", "label": "contexto e resposta no mesmo atendimento" },
    { "id": "e6", "from": "participacao", "to": "cabecalho", "label": "refetch confirma o vínculo" },
    { "id": "e7", "from": "resposta", "to": "controle", "label": "responder não transfere controle" }
