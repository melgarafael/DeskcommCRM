    { "id": "cabecalho", "lane": "tela", "col": 1, "type": "frontend", "label": "ParticipantesDaConversa: convidar, remover e sair" },
    { "id": "rota", "lane": "servidor", "col": 2, "type": "route", "label": "participants: sessão, tenant, dono/gestor e alvo ativo" },
    { "id": "participacao", "lane": "banco", "col": 3, "type": "database", "label": "conversation_participants: vínculo único e left_at" },
    { "id": "auditoria", "lane": "banco", "col": 3, "type": "database", "label": "api_audit_log: convidado e removido" },
    { "id": "leitura", "lane": "servidor", "col": 4, "type": "backend", "label": "RLS: conversa/mensagens; lista Minhas e contador" },
