    {
      "id": "distribuir-conversas",
      "titulo": "Como as conversas são distribuídas",
      "objetivo": "Escolher se as conversas novas esperam na fila ou vão sozinhas para alguém da equipe.",
      "papel": "admin",
      "busca": [
