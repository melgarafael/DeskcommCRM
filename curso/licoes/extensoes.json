              "acao": "click",
              "alvo": {
                "role": "combobox",
                "nome": "Filtrar por categoria"
              }
            }
          ],
          "destaques": [
            {
              "alvo": {
                "role": "listbox"
              },
              "rotulo": "Categorias",
              "tipo": "caixa"
            }
          ]
        }
      ]
