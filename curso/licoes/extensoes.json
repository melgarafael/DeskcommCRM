      "passos": [
        {
          "id": "p1",
          "titulo": "Onde ficam as extensões",
          "texto": "Abra \"Configurações\", no rodapé do menu lateral. Na parte \"Sua empresa\" fica o cartão \"Extensões\". Clique nele.",
