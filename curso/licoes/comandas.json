      "passos": [
        {
          "id": "p1",
          "titulo": "Onde fica a tela",
          "rota": "/app/crm",
          "texto": "Comanda é a conta de um atendimento: o que foi feito e quanto o cliente paga. Comandas não aparece direto no menu da esquerda. No grupo \"CRM\", clique em \"Ver tudo em CRM\". Na parte \"O dia a dia da venda\" fica o cartão \"Comandas\". O caminho completo é: CRM › Ver tudo em CRM › Comandas. Para seguir, clique no cartão.",
          "dica": "O cartão só aparece depois que quem administra o servidor instala o módulo \"Comandas\" no Admin, em \"Módulos\". A instalação vale para todas as empresas do servidor. Sem ela, nem o cartão nem a tela existem.",
          "antes": [],
          "destaques": [
            {
              "alvo": {
                "role": "link",
                "nome": "Ver tudo em CRM",
                "exato": true
              },
              "rotulo": "Ver tudo em CRM",
              "tipo": "numero"
            },
            {
              "alvo": {
                "role": "link",
                "nome": "^Comandas",
                "regex": true
              },
              "rotulo": "Abrir as comandas",
              "tipo": "caixa"
            }
          ],
          "clicar": {
            "role": "link",
            "nome": "^Comandas",
            "regex": true
          }
        },
        {
