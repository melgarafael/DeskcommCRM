          "destaques": [
            {
              "alvo": {
                "role": "link",
                "nome": "Ver",
                "exato": true,
                "n": 0
              },
              "rotulo": "Abrir o incidente",
              "tipo": "caixa"
            }
          ]
        }
      ]
    },
    {
