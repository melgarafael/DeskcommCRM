    {
      "id": "resolvendo-um-incidente",
      "titulo": "Lendo e resolvendo um incidente",
      "objetivo": "Ler a página de um incidente, registrar como ele foi resolvido e ver que ele saiu da lista de abertos.",
      "papel": "admin",
      "busca": [
        "resolver incidente",
        "marcar problema como resolvido",
        "nota de resolução",
        "detalhes do incidente",
        "whatsapp caiu no servidor",
        "fechar alerta crítico"
      ],
      "passos": [
        {
          "id": "p1",
          "titulo": "A página do incidente",
          "texto": "Esta é a página que abre ao clicar em \"Ver\": aqui, o número de WhatsApp da Clínica Bem Viver que caiu. No alto ficam o código do problema, os selos de gravidade e de situação, o apelido da empresa e a data em que foi aberto. \"Incidentes\", acima do título, volta para a lista.",
          "rota": "/admin/incidents",
          "antes": [
            {
              "acao": "click",
              "alvo": {
                "role": "link",
                "nome": "Ver",
                "exato": true,
                "dentro": {
                  "role": "row",
                  "nome": "whatsapp\\.session_disconnected",
                  "regex": true
                }
              }
            },
            {
              "acao": "aguardar",
              "alvo": {
                "role": "heading",
                "nome": "whatsapp.session_disconnected",
                "exato": true
              }
            }
          ],
          "destaques": [
            {
              "alvo": {
                "css": "div.min-w-0.space-y-2:has(> h1)"
