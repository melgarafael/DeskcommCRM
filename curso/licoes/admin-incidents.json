              "acao": "click",
              "alvo": {
                "role": "link",
                "nome": "Incidentes",
                "exato": true,
                "dentro": {
                  "role": "main"
                }
              }
            },
            {
              "acao": "aguardar",
              "alvo": {
                "css": "tbody"
              }
            },
            {
              "acao": "esperar",
              "ms": 1000
            }
          ],
          "destaques": [
            {
              "alvo": {
                "texto": "^\\d+ incidentes?\\+?$",
                "regex": true
              },
              "rotulo": "Um a menos",
              "tipo": "caixa"
            },
            {
              "alvo": {
                "css": "tbody"
              },
              "rotulo": "Só os que faltam resolver",
              "tipo": "caixa"
            }
          ]
        }
