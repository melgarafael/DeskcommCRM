              },
              "rotulo": "Nada marcado com o cliente",
              "tipo": "caixa"
            }
          ]
        },
        {
          "id": "p3",
          "titulo": "Em risco: entre 1 e 3 dias",
          "texto": "\"Em risco\" é o negócio parado há mais de 24 horas e menos de 3 dias. Ainda dá tempo de retomar com calma, mas ele vira crítico se continuar esquecido.",
          "destaques": [
            {
              "alvo": {
                "texto": "Em risco",
                "exato": true,
                "dentro": {
                  "css": "[data-testid=radar-item]:has-text(\"Renata Duarte\")"
                }
              },
              "rotulo": "Em risco",
              "tipo": "seta"
            },
            {
              "alvo": {
                "texto": "parado há 30h",
                "dentro": {
                  "css": "[data-testid=radar-item]:has-text(\"Renata Duarte\")"
                }
              },
              "rotulo": "Parado há 30 horas",
              "tipo": "caixa"
            }
          ]
        },
        {
          "id": "p4",
          "titulo": "Em voo: o assistente vai voltar a falar",
          "texto": "\"Em voo\" é o negócio parado, mas com um retorno já marcado pelo assistente. A linha mostra quando ele pretende voltar a falar com o cliente, como \"Assistente retorna em 2d\". Ele não está esquecido: só fique de olho, porque o retorno só sai se o WhatsApp estiver conectado e o assistente estiver ligado.",
          "destaques": [
            {
              "alvo": {
                "texto": "Em voo",
                "exato": true,
                "dentro": {
                  "css": "[data-testid=radar-item]:has-text(\"Gustavo Ramos\")"
