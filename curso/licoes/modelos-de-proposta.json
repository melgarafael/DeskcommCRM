              "acao": "rolar",
              "alvo": {
                "role": "heading",
                "nome": "Modelos de proposta",
                "exato": true
              }
            }
          ],
          "destaques": [
            {
              "alvo": {
                "css": "section:has-text('Criar a partir da proposta que a empresa já usa')"
