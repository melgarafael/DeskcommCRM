      "passos": [
        {
          "id": "p1",
          "titulo": "Começar um tipo novo",
          "texto": "Vamos cadastrar o \"Retorno de fisioterapia\", uma volta rápida do paciente depois do tratamento. Clique em \"Novo tipo de agendamento\".",
