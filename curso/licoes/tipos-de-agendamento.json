              },
              "opcao": "Retorno"
            },
            {
              "acao": "fill",
              "alvo": {
                "testid": "novo-tipo-duracao"
              },
              "valor": "30"
            },
            {
              "acao": "selecionar",
              "alvo": {
                "testid": "novo-tipo-local"
              },
              "opcao": "Presencial"
            },
            {
              "acao": "selecionar",
              "alvo": {
                "testid": "novo-tipo-dono"
              },
              "opcao": "Ana Ribeiro"
            }
          ],
          "destaques": [
            {
