    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-hotkeys-hook": "^5.3.3",
    "recharts": "^3.10.1",
    "require-in-the-middle": "^8.0.1",
    "resend": "^6.18.1",
