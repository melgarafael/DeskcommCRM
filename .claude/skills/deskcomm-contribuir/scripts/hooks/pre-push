#!/usr/bin/env bash
# pre-push do contribuidor — protege a main, não o trabalho.
#
# A main é produção: recebe merge de PR revisado, nunca push direto. Feature
# branch existe para ser revisada — o PR e o CI são o gate, e este hook não os
# duplica. O único outro efeito é um AVISO quando a branch está atrasada em
# relação a origin/main: o CI mede a branch, não o merge, e verde numa branch
# atrasada não prova nada sobre o que vai entrar.
set -uo pipefail

bloqueadas=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master) bloqueadas="$bloqueadas $remote_ref" ;;
  esac
  if [ -n "${local_sha:-}" ] && git rev-parse -q --verify origin/main >/dev/null 2>&1; then
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null || true)"
    if [ -n "$base" ]; then
      atraso="$(git rev-list --count "$base..origin/main" 2>/dev/null || echo 0)"
      if [ "$atraso" -gt 0 ]; then
        echo "aviso: esta branch está $atraso commit(s) atrás de origin/main (o CI testa a branch, não o merge)." >&2
        echo "       git fetch origin && git merge origin/main   # nunca reset --hard" >&2
      fi
    fi
  fi
done

if [ -n "$bloqueadas" ]; then
  echo "pre-push BLOQUEADO:$bloqueadas — a main é produção e não recebe push direto." >&2
  echo "Abra uma branch (git switch -c fix/o-que-conserta) e um PR; o merge acontece pelo review + CI." >&2
  exit 1
fi
exit 0
